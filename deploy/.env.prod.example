# Copy to ".env" on the server (deploy/aws-deploy.sh does it for you). Never commit a real .env.

# The public name of the app. A domain you own (point its A record at the server's Elastic IP), or <ip-with-dashes>.sslip.io.
DOMAIN=

# Generated by aws-deploy.sh. Long and random.
POSTGRES_PASSWORD=
JWT_SECRET=

# Bedrock reads the photos with the server's IAM role, so there are no AWS keys here.
SCANNER=bedrock
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# true: the lived-in demo city (officers, dealers, households, pools). false: only the small starting data.
DEMO_RICH=true
