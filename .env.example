# Copy this file to ".env" (it is git-ignored) and fill it in. docker compose reads it automatically.
# Never commit real keys.

# "mock": no AWS needed, the user picks the item in Demo mode.
# "bedrock": the photo is analysed by Amazon Bedrock.
SCANNER=mock

# Needed only for SCANNER=bedrock. Use an IAM user that is allowed to call bedrock:InvokeModel,
# and enable the model under Bedrock > Model access in the AWS console first.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Change this anywhere that is not your own laptop (32+ characters).
JWT_SECRET=
