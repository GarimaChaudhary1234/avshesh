server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Behind a proxy (Caddy on the server) the client address is in X-Forwarded-For. Only the proxy range in
    # TRUST_PROXY_CIDR is believed; anywhere else (the default, the local machine) the address of the connection is used,
    # so nobody can choose the address that the login and scan limits count.
    set_real_ip_from ${TRUST_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Photos for /scan; the backend limit is 5 MB per file.
    client_max_body_size 6m;

    # The browser only ever talks to this one origin, so no CORS is needed.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # The backend may sit behind another domain (App Runner routes by Host), so send its own host name.
        proxy_set_header Host ${BACKEND_HOST};
        proxy_ssl_server_name on;
        # Overwrite, never append: a client must not be able to choose the address the backend sees
        # (the login and scan limits are counted per client address).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Built files have a content hash in their name, so they can be cached for a long time.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # index.html points at the current hashed files, so it must never be served from a stale cache.
    location / {
        add_header Cache-Control "no-store";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
